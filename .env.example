# ---------------------------------------------------------------------------
# Copie para .env (na raiz do projeto) antes do primeiro `docker compose up`.
# ---------------------------------------------------------------------------

TZ=America/Cuiaba

# --- Postgres + pgvector ---------------------------------------------------
POSTGRES_USER=iacoder
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=iacoder
# 5433 no host de propósito: não conflita com um Postgres já instalado no Windows.
POSTGRES_PORT=5433

# --- Redis -----------------------------------------------------------------
REDIS_PORT=6379

# --- Ferramentas opcionais -------------------------------------------------
OLLAMA_PORT=11434

# --- Modo conversa (perfil "voice" do compose) -----------------------------
# Whisper: fala → texto, rodando na sua máquina.
# small equilibra qualidade e CPU; medium acerta mais e é bem mais lento;
# base é rápido e erra mais em termo técnico.
WHISPER_MODEL=small
WHISPER_PORT=9000
WHISPER_URL=http://localhost:9000

# Piper: texto → fala em pt-BR. A voz é baixada na primeira execução.
PIPER_VOICE=pt_BR-faber-medium
PIPER_PORT=5002
PIPER_URL=http://localhost:5002

# O nome que acorda a ferramenta. "jarvis" também funciona, sempre.
VOICE_WAKE_WORD=ia coder

# --- Usado pelo servidor (apps/server), que roda no Windows, fora do Docker --
# O servidor monta o endereço do Postgres a partir das variáveis acima
# (POSTGRES_USER/PASSWORD/DB/PORT), então normalmente você NÃO precisa declarar
# DATABASE_URL. Descomente só para apontar para um banco diferente do compose.
# DATABASE_URL=postgresql://usuario:senha@outro-host:5432/outra-base
REDIS_URL=redis://localhost:6379

# Onde os artefatos gerados (MD, imagens, decks) são gravados. O painel Archives
# aponta para cá — é uma pasta normal do Windows, aberta com um duplo clique.
ARTIFACTS_DIR=./workspace/artifacts

# Motor de embeddings do Tree: "ollama" (local, sem chave) ou "none" (desliga
# a busca semântica e mantém só os vínculos explícitos entre os nós).
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_DIM=768
OLLAMA_URL=http://localhost:11434

# --- Servidor (apps/server) ------------------------------------------------
# Porta do WebSocket que o frontend consome (VITE_WS_URL).
SERVER_PORT=8787
SERVER_HOST=127.0.0.1

# Pasta aberta quando ainda não há nada salvo em workspace/prefs.json.
# Depois disso, quem manda é o botão PROJETO na barra de cima.
DEFAULT_PROJECT_PATH=G:\IA_Coder

# --- Claude Code -----------------------------------------------------------
# Caminho do executável, se não estiver no PATH.
CLAUDE_BIN=claude
# acceptEdits  → aceita edições de arquivo sem perguntar (padrão, sensato)
# bypassPermissions → libera tudo, inclusive comandos. Só na sua máquina.
CLAUDE_PERMISSION_MODE=acceptEdits
# CLAUDE_MODEL=claude-sonnet-5
CLAUDE_AUTOSTART=true

# --- Shell -----------------------------------------------------------------
# No Windows o padrão é o powershell.exe; fora dele, /bin/bash.
# SHELL_BIN=powershell.exe
SHELL_AUTOSTART=true
