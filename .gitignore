node_modules/
dist/
.tsbuild/
*.tsbuildinfo
.env
.env.local
*.log
.DS_Store
Thumbs.db

# Artefatos gerados pelos agentes: ficam no disco, não no repositório.
workspace/artifacts/*
!workspace/artifacts/.gitkeep

# Gravados pela tela de Configurações e pelo seletor de projeto — têm senha de
# banco e caminho local da sua máquina. Nunca vão para o repositório.
workspace/settings.json
workspace/prefs.json

# Saída do electron-builder (o .exe do instalador é grande e é build, não código).
apps/desktop/release/

# Rascunho do post de lançamento — é seu, não vai para o repositório.
docs/linkedin-lancamento.md

# Certificado do proxy corporativo: público, mas identifica a infraestrutura
# de segurança da empresa — não vai para repositório público.
certs/

# Guia e scripts do WSL: ficam só na máquina. O README descreve a rede
# corporativa (proxy que intercepta TLS), que não vai para repositório público.
WSL/
